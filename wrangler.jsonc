{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ninjaschool-ranking",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ninjaschool-ranking"
    }
  ],
  // Filled in after running `wrangler d1 create ninjaschool-ranking-db` — see DEPLOY.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ninjaschool-ranking-db",
      "database_id": "2931ce10-b2dd-4ef9-939c-345793e09aa2"
    }
  ],
  // Real value is never stored here — set with `wrangler secret put
  // GOOGLE_SERVICE_ACCOUNT_JSON` for production, or in .dev.vars (gitignored)
  // for local dev. This empty placeholder only exists so `wrangler types`
  // knows the binding's shape.
  "vars": {
    "GOOGLE_SERVICE_ACCOUNT_JSON": ""
  }
}
